{
  "name": "sim-unlimited",
  "private": true,
  "version": "0.0.1",
  "description": "Browser flight simulator over the real Earth, built on the fly from OpenStreetMap and elevation data",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/perf.test.ts && vitest run tests/perf.test.ts"
  },
  "dependencies": {
    "@kninnug/constrainautor": "4.1.0",
    "delaunator": "^5.1.0",
    "earcut": "^3.2.4",
    "gl-matrix": "^3.4.3"
  },
  "devDependencies": {
    "@types/earcut": "^3.0.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.6.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
